{
  "name": "card-gallery",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check:cards": "node scripts/card-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "pnpm build && pnpm test:browser:built",
    "test:browser:built": "node scripts/test-gallery-browser.mjs && node scripts/test-browser.mjs && node scripts/test-studio-browser.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.61.1",
    "sharp": "0.35.5",
    "three": "0.169.0",
    "yaml": "2.9.1"
  }
}
