{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "card-gallery",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "card.thanejoss.com/*", "zone_name": "thanejoss.com" }
  ],
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    "directory": "./public"
  },
  "previews": {}
}

